# Copy to .env at the repo root. Everything is optional for local development:
# without a key or model the app runs with AI turned off.

# --- Database ---
# Unset or file:<path> = local PGlite (embedded Postgres) under the repo root.
# postgres://... = a real Postgres server, e.g. Neon in production.
DATABASE_URL=file:./.data/orbit

# --- Meta Model API (server-side only; never prefix these with VITE_) ---
META_API_KEY=
# OpenAI-compatible endpoint.
META_API_BASE_URL=https://api.meta.ai/v1
# Model IDs as listed in the Meta Model API docs (dev.meta.ai/docs/overview, checked 2026-10-27).
META_MODEL_AGENT=muse-spark-1.3
# Optional: a cheaper model for translating messages and drafts. Unset uses META_MODEL_AGENT.
# (As of 2026-10-28 Meta offers no cheaper Standard-tier text model than Muse Spark.)
META_MODEL_TRANSLATE=
META_MODEL_VOICE=muse-voice-transcribe-1.0
META_MODEL_VISION=muse-spark-1.3

# --- Muse Spark Open on Baseten (server-side only) ---
# Optional: Meta's open-weight Muse Spark Open, for inbox reply drafts and translations. Both set
# moves those two features there; any failed call (credits, rate limit) falls back to Meta's API.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Demo limits ---
# Total tokens the agent may use per day across all visitors.
AI_DAILY_TOKEN_BUDGET=2000000
# Agent calls allowed per IP per hour.
AI_RATE_LIMIT_PER_HOUR=20
# Hard cap on real Meta spend per UTC month, from recorded usage.
AI_MONTHLY_BUDGET_USD=100

# --- Demo access ---
# When set, visitors must enter this code before the app shows anything (the phone ID scan page
# stays open, keyed by its scan link). Unset leaves the app open. Changing it signs everyone out.
DEMO_ACCESS_CODE=

# --- API server ---
PORT=3001
