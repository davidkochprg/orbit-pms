# Copy to .env at the repo root:  cp .env.example .env
#
# Only META_API_KEY is needed to turn the AI on; every other value already works as it is.
# Without a key the app still runs, with the AI features turned off.

# --- Meta Model API (required for AI; server-side only, never prefix with VITE_) ---
META_API_KEY=
# OpenAI-compatible endpoint.
META_API_BASE_URL=https://api.meta.ai/v1
# Model IDs as listed in the Meta Model API docs (dev.meta.ai/docs/overview, checked 2026-10-27).
# The agent, inbox, housekeeping notes, stay notes and rate summary:
META_MODEL_AGENT=muse-spark-1.3
# Housekeeping voice notes (speech-to-text). Empty turns voice off; typed notes still work.
META_MODEL_VOICE=muse-voice-transcribe-1.0
# Reading phone scans of ID documents. Empty turns ID scans off.
META_MODEL_VISION=muse-spark-1.3
# Optional: another model for translations. Empty uses META_MODEL_AGENT.
META_MODEL_TRANSLATE=

# --- Muse Spark Open on Baseten (optional; server-side only) ---
# Meta's open-weight Muse Spark Open, for inbox reply drafts and translations. Leave the key
# empty to run those on the Meta Model API too. A failed Baseten call falls back to Meta.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Database ---
# file:<path> = embedded Postgres (PGlite) under the repo root, nothing to install.
# postgres://... = a real Postgres server, e.g. Neon in production.
DATABASE_URL=file:./.data/orbit

# --- Hotel ---
# Which demo hotel `pnpm db:seed` builds: us (a US mountain lodge, the default) or cz (a Czech
# guesthouse). For cz also set HOTEL_TIMEZONE=Europe/Prague.
SEED_REGION=us
# The hotel's time zone, which decides what "today" is.
HOTEL_TIMEZONE=America/Los_Angeles

# --- AI limits ---
# Generous for one person trying the app on their own key; lower them for a shared demo.
# AI calls (agent, inbox, notes, summaries) allowed per IP per hour.
AI_RATE_LIMIT_PER_HOUR=300
# Tokens per day across all users, about 1,000 agent turns.
AI_DAILY_TOKEN_BUDGET=20000000
# Hard cap on real spend per UTC month, from recorded usage. The rest of Orbit keeps working.
AI_MONTHLY_BUDGET_USD=50

# --- Demo access ---
# When set, visitors must enter this code before the app shows anything. Leave empty locally.
DEMO_ACCESS_CODE=

# --- Ports ---
# The API; the web app at http://localhost:5173 follows it.
PORT=3001
